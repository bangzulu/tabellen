# Nycklar från developer.trafiklab.se (projekt -> API-produkter)
# GTFS Regional Static (Bronze: 50 anrop/månad – laddas ner max en gång per dygn)
GTFS_STATIC_KEY=
# GTFS Regional Realtime (Bronze: 30 000 anrop/månad)
GTFS_RT_KEY=

# Hur länge ett hämtat realtidsflöde återanvänds (sekunder).
# Hämtning sker bara när någon tittar på sidan.
RT_CACHE_SECONDS=30
# Äldre data visas direkt medan nytt hämtas i bakgrunden, upp till så här många sekunder.
RT_STALE_OK_SECONDS=300
# Störningsflödet (ServiceAlerts) hämtas mer sällan.
ALERTS_CACHE_SECONDS=120
# Hämta även VehiclePositions (dubblar anropen). Används som reserv för avläsningsplats.
USE_VEHICLE_POSITIONS=false
# Max realtidsanrop per kalendermånad innan appen slutar hämta (skydd mot spärrad nyckel)
RT_MONTHLY_BUDGET=28000
# Data äldre än så här markeras som inaktuell i gränssnittet (samma som kitt: 2 min)
MAX_DATA_AGE_SECONDS=120
# Utveckling utan nya anrop: läs sparade flöden från data/ (skapas av coverage_check.py)
USE_SAVED_FEEDS=false
